# Copy to .env and adjust. Empty peer addresses skip gRPC ping.

# --- gateway (Single Ingress Nginx, default port 80) ---
GATEWAY_PORT=80

# --- api_svc ---
API_HTTP_ADDR=:8080
API_GRPC_ADDR=:50051
POSTGRES_DSN=postgres://restick:restick@postgres:5432/restick?sslmode=disable
JWT_SECRET=change-me-jwt
BOOTSTRAP_ADMIN_EMAIL=admin@restick.local
BOOTSTRAP_ADMIN_PASSWORD=changeme
BOOTSTRAP_API_KEY=dev-api-key
INTERNAL_TOKEN=dev-internal-token
WEB_ORIGIN=http://localhost:8088

# --- ftp_svc ---
FTP_HTTP_ADDR=:8080
FTP_GRPC_ADDR=:50052
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=restick
MINIO_SECRET_KEY=resticksecret
MINIO_BUCKET=restick-assets
MINIO_USE_SSL=false


# --- img_tool ---
IMG_HTTP_ADDR=:8080
IMG_GRPC_ADDR=:50053
IMG_TOOL_ENGINE=simple
PUBLIC_FTP_ORIGIN=http://localhost:8081
# Loopback in PUBLIC_FTP_ORIGIN is rewritten to the Host of each API request
# (Android emulator → 10.0.2.2:8081). Set a real origin in production.

# --- web (Flutter UI, host port 8088; rebuild after changing public URLs) ---
RESTICK_PUBLIC_API_BASE=http://localhost:8080

# --- gRPC peers (Docker DNS on one host, or host:port across machines) ---
API_SVC_GRPC_ADDR=api_svc:50051
FTP_SVC_GRPC_ADDR=ftp_svc:50052
IMG_TOOL_GRPC_ADDR=img_tool:50053
