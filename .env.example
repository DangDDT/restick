# Restick runtime environment template. Copy to .env and keep the real values
# (data path, secret path, origin) out of git.

# Required: public HTTPS origin; also used for admin Origin checks and asset URLs.
RESTICK_PUBLIC_BASE_URL=https://stickers.example.com

# Host path of the one-time owner password secret file (read-only mount).
# The first start of a fresh data dir requires it; later starts ignore it.
RESTICK_ADMIN_PASSWORD_SECRET=./secrets/admin_password

# Host data directory. On Linux create it ahead of time with:
#   install -d -o 10001 -g 10001 ./data
RESTICK_DATA_HOST=./data

# Optional: pin an immutable release tag or digest. Never deploy a mutable
# "latest" tag; use the published release tag/digest here.
RESTICK_IMAGE=ghcr.io/OWNER/restick:RELEASE_TAG

# Optional: only list the real reverse-proxy peers, never private ranges.
RESTICK_TRUSTED_PROXY_CIDRS=

# Optional: one processing job at most, 300s default.
RESTICK_PROCESS_TIMEOUT=300s
