# --- gateway ---
GATEWAY_PORT=80

# --- api_svc ---
API_HTTP_ADDR=:8080
API_GRPC_ADDR=:50051
POSTGRES_DSN=postgres://restick:restick@postgres:5432/restick?sslmode=disable
POSTGRES_USER=restick
POSTGRES_PASSWORD=restick
POSTGRES_DB=restick
JWT_SECRET=change-me-min-32-chars-random
BOOTSTRAP_ADMIN_EMAIL=admin@restick.local
BOOTSTRAP_ADMIN_PASSWORD=changeme
BOOTSTRAP_API_KEY=dev-api-key
INTERNAL_TOKEN=dev-internal-token
# Production: set to your public domain (same for all three when behind unified gateway)
WEB_ORIGIN=http://localhost:8088
# Comma-separated for multiple allowed origins: WEB_ORIGIN=https://a.com,https://b.com

# --- ftp_svc ---
FTP_HTTP_ADDR=:8080
FTP_GRPC_ADDR=:50052
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=restick
MINIO_SECRET_KEY=resticksecret
MINIO_BUCKET=restick-assets
MINIO_USE_SSL=false

# --- img_tool ---
IMG_HTTP_ADDR=:8080
IMG_GRPC_ADDR=:50053
IMG_TOOL_ENGINE=simple
# Production: set PUBLIC_FTP_ORIGIN to https://your-domain.com (same as WEB_ORIGIN)
# Loopback is rewritten to request Host for mobile dev; non-loopback is used as-is.
PUBLIC_FTP_ORIGIN=http://localhost

# --- web (Flutter; rebuild after changing BASE_URL) ---
# Production: set to https://your-domain.com, or leave empty for same-origin auto-detect
RESTICK_PUBLIC_API_BASE=http://localhost:8080

# --- gRPC peers ---
API_SVC_GRPC_ADDR=api_svc:50051
FTP_SVC_GRPC_ADDR=ftp_svc:50052
IMG_TOOL_GRPC_ADDR=img_tool:50053
